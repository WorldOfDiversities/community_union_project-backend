# Environment Configuration Example for the backend
# Copy this to a file named .env (DO NOT commit .env to git) and fill values.

# -----------------------
# Core / Security
# -----------------------
DJANGO_SECRET_KEY=replace-with-a-very-secret-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.onrender.com

# -----------------------
# Database (use Supabase / DATABASE_URL recommended)
# Example Supabase DATABASE_URL (direct connection, include sslmode=require):
# postgresql://postgres:YOUR_PASSWORD@db.ncdlncqapgcoqaqriebv.supabase.co:5432/postgres?sslmode=require
# Using your Supabase pooler (URL-encode the password portion). Example below
# Pooler URL format (password must be URL-encoded):
# postgresql://postgres.<project_host>:<URL_ENCODED_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.ncdlncqapgcoqaqriebv:YOUR_URL_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------
# CORS / Auth
# -----------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.onrender.com,https://community-union-project.vercel.app
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=replace-with-nextauth-secret

# -----------------------
# Celery / Redis (optional)
# -----------------------
#CELERY_BROKER_URL=redis://:PASSWORD@redis.example.com:6379/0
#REDIS_URL=redis://:PASSWORD@redis.example.com:6379/0

# -----------------------
# Email (optional)
# -----------------------
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=your-email@example.com
#EMAIL_HOST_PASSWORD=your-email-password
#DEFAULT_FROM_EMAIL=no-reply@example.com

# -----------------------
# Storage (Supabase Storage or S3-compatible)
# To use Supabase Storage with django-storages (S3 API), set these and
# configure DEFAULT_FILE_STORAGE accordingly in settings (optional).
# -----------------------
#DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
#AWS_ACCESS_KEY_ID=your-access-key
#AWS_SECRET_ACCESS_KEY=your-secret
#AWS_STORAGE_BUCKET_NAME=your-bucket-name
#AWS_S3_ENDPOINT_URL=https://<project>.supabase.co
#AWS_S3_REGION_NAME=us-east-1

# -----------------------
# Monitoring / Misc
# -----------------------
#SENTRY_DSN=

# Any other env variables your deployment requires
#MY_CUSTOM_VAR=value
